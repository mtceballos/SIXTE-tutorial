# Ignore checkoutpoints and cache
__pycache__
.ipynb_checkpoints


# Ignore all files with a specific extension
*.xml
*.xcm
*.fits
*.lc
*.rmf
*.arf
*.pha
*.gif
*.reg

# Versioned inputs for the NewAthena extended-source curriculum.
!newathena-extended-sources/inputs/**/*.xcm
!newathena-extended-sources/inputs/**/*.reg
